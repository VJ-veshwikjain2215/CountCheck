# Copy this file to .env.local and replace the placeholders.
# .env.local is ignored and excluded from the deployment archive.
# Use the Java/JDBC connection details from your hosted PostgreSQL provider.
DB_JDBC_URL=jdbc:postgresql://HOST:5432/DATABASE?sslmode=verify-full&sslfactory=org.postgresql.ssl.DefaultJavaSSLFactory
DB_USERNAME=YOUR_DATABASE_USER
DB_PASSWORD=YOUR_DATABASE_PASSWORD
